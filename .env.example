# Copie para .env e ajuste os valores.
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
TOKEN_EXPIRES_MINUTES=60
DATABASE_PATH=agendamed.db
CLINIC_TIMEZONE=America/Sao_Paulo
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# true quando houver um proxy reverso confiável na frente (Render, Nginx...)
TRUST_PROXY=false
# true para criar dados de demonstração na inicialização, se o banco estiver vazio
SEED_DEMO_DATA=false
